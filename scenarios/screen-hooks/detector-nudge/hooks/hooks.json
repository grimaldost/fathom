{
  "description": "Fire a discipline nudge once, before the agent's first code edit (PreToolUse).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--", "python", "${CLAUDE_PLUGIN_ROOT}/detect.py"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--", "python", "${CLAUDE_PLUGIN_ROOT}/detect.py"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
