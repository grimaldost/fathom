{
  "description": "Local shape-matched control: block each subagent once with a bookkeeping request of matched length that names no verification act.",
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/gate.py"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
