{
  "description": "Block each subagent once before it finishes and inject a verification-before-completion reconsideration.",
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--", "python", "${CLAUDE_PLUGIN_ROOT}/gate.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
