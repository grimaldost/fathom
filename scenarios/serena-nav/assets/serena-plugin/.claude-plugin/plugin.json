{
  "name": "serena-arm",
  "version": "0.1.0",
  "description": "Mounts the serena MCP server (pinned) for the armed arm of the serena-nav bank",
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent==1.6.1",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--enable-web-dashboard",
        "false"
      ]
    }
  }
}
