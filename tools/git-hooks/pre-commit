#!/bin/sh
# fathom's pre-commit hook, installed via `git config core.hooksPath tools/git-hooks`.
#
# Why not `pre-commit install`? That writes a hook which invokes the `pre-commit`
# console-script shim directly, and some environments block the console-script shim while
# still running a git-invoked hook. Invoking the module through `uv run` works in those
# environments and elsewhere, and pins the project's interpreter, so the commit lane
# actually runs rather than silently not.
#
# Tracked, so a fresh clone gets the hook with one command instead of a recipe. Skip a run
# with `git commit --no-verify` when you mean to; CI runs the full set regardless.
HERE=$(dirname "$0")
exec uv run python -m pre_commit hook-impl \
	--config=.pre-commit-config.yaml \
	--hook-type=pre-commit \
	--hook-dir "$HERE" \
	-- "$@"
